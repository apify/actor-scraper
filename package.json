{
    "name": "actor-scraper",
    "private": true,
    "description": "Apify generic scrapers monorepo",
    "keywords": [
        "apify",
        "headless",
        "chrome",
        "puppeteer",
        "crawler",
        "scraper"
    ],
    "author": {
        "name": "Apify",
        "email": "support@apify.com",
        "url": "https://apify.com"
    },
    "contributors": [
        "Jan Curn <jan@apify.com>",
        "Marek Trunkat <marek@apify.com>",
        "Ondra Urban <ondra@apify.com>"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apify/actor-scraper.git"
    },
    "bugs": {
        "url": "https://github.com/apify/actor-scraper/issues"
    },
    "homepage": "https://github.com/apify/actor-scraper",
    "scripts": {
        "prepare": "husky",
        "prepublishOnly": "turbo run copy",
        "clean": "turbo run clean",
        "build": "turbo run build",
        "ci:build": "turbo run build --cache-dir=\".turbo\"",
        "test": "vitest run --silent",
        "test:e2e": "node test/e2e/runScraperTests.mjs",
        "tsc-check-tests": "tsc --noEmit --project test/tsconfig.json",
        "coverage": "vitest --coverage",
        "release": "pnpm build && lerna publish from-package --contents dist",
        "publish:next": "lerna publish --canary --preid beta --dist-tag next",
        "release:next": "pnpm build && pnpm publish:next",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "lint-staged": {
        "*.{ts,mts,cts,js,mjs,cjs}": [
            "oxfmt --write --no-error-on-unmatched-pattern",
            "oxlint --type-aware --fix --no-error-on-unmatched-pattern"
        ]
    },
    "devDependencies": {
        "@apify/consts": "^2.57.0",
        "@apify/input_secrets": "^1.2.54",
        "@apify/log": "^2.5.48",
        "@apify/oxlint-config": "^0.3.0",
        "@apify/tsconfig": "^0.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@isaacs/brace-expansion": "^5.0.1",
        "@playwright/browser-chromium": "^1.62.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^24.13.3",
        "@types/semver": "^7.8.0",
        "@types/tough-cookie": "^4.0.5",
        "@types/ws": "^8.18.1",
        "apify": "^3.7.2",
        "apify-client": "^2.24.0",
        "commitlint": "^21.2.1",
        "crawlee": "^3.18.0",
        "fs-extra": "^11.4.0",
        "gen-esm-wrapper": "^1.1.3",
        "globby": "^14.1.0",
        "husky": "^9.1.7",
        "lerna": "^10.0.0",
        "lint-staged": "^17.3.0",
        "oxfmt": "0.66.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "playwright": "^1.62.1",
        "puppeteer": "25.4.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.5",
        "turbo": "2.10.12",
        "typescript": "~6.0.3",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.24.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.20.0",
            "onFail": "warn"
        }
    }
}
